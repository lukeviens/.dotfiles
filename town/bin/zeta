#!/bin/sh
# Zeta 2.1 on the loopback endpoint used by Neovim.
mkdir -p "$HOME/.cache/town"
exec /usr/bin/lockf -k -t 0 "$HOME/.cache/town/zeta.lock" llama-server \
  -hf mradermacher/zeta-2.1-GGUF:Q8_0 \
  --alias zeta-2.1 \
  --host 127.0.0.1 \
  --port 8012 \
  --ctx-size 16384 \
  --n-gpu-layers all >> "$HOME/.cache/town/zeta.log" 2>&1
