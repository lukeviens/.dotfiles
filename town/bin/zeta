#!/bin/sh
# Zeta 2.1 on the loopback endpoint used by Neovim.
# Which quant/context fits is a per-machine fact, not source — this box needs Q4_K_M, another
# might run Q8_0 fine. model.conf.sh is gitignored and self-heals with this machine's own values
# on first run, so a fresh clone works immediately and each machine tunes its own copy without
# ever touching the commit.
cd "$(dirname "$0")" || exit 1
if [ ! -f model.conf.sh ]; then
  cat > model.conf.sh <<'DEFAULTS'
MODEL="mradermacher/zeta-2.1-GGUF:Q4_K_M"
MODEL_CTX_SIZE=16384
MODEL_GPU_LAYERS=all
DEFAULTS
fi
. ./model.conf.sh

mkdir -p "$HOME/.cache/town"
exec /usr/bin/lockf -k -t 0 "$HOME/.cache/town/zeta.lock" llama-server \
  -hf "$MODEL" \
  --alias zeta-2.1 \
  --host 127.0.0.1 \
  --port 8012 \
  --ctx-size "$MODEL_CTX_SIZE" \
  --n-gpu-layers "$MODEL_GPU_LAYERS" >> "$HOME/.cache/town/zeta.log" 2>&1
