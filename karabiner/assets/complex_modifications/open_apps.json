{
  "title": "App shortcuts with Option key",
  "rules": [
    {
      "description": "open google chrome",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "1",
            "modifiers": {
              "mandatory": ["option"]
            }
          },
          "to": [
            {
              "shell_command": "open -a 'Google Chrome.app'"
            }
          ]
        }
      ]
    },
    {
      "description": "open wezterm",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "2",
            "modifiers": {
              "mandatory": ["option"]
            }
          },
          "to": [
            {
              "shell_command": "open -a 'WezTerm.app'"
            }
          ]
        }
      ]
    },
    {
      "description": "open slack",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "3",
            "modifiers": {
              "mandatory": ["option"]
            }
          },
          "to": [
            {
              "shell_command": "open -a 'Slack.app'"
            }
          ]
        }
      ]
    }
  ]
}
